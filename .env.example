# Local native PostgreSQL (Windows)
# Copy this file to .env and replace the placeholders with your local credentials.
# The .env file is ignored by Git and must never be committed.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/vollailelink
SPRING_DATASOURCE_USERNAME=your_native_postgres_user
SPRING_DATASOURCE_PASSWORD=your_native_postgres_password

# Admin credentials (for initial setup)
ADMIN_PHONE=+221xxxxxxxxx
ADMIN_PASSWORD=your_admin_password_here

# JWT configuration
# Generate a long random value; never keep the placeholder below.
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRATION_MS=3600000

# Local server
SERVER_PORT=8083

# Optional future Docker deployment only — not used for local development
# POSTGRES_DB=vollailelink
# POSTGRES_USER=vollailelink
# POSTGRES_PASSWORD=your_server_postgres_password
